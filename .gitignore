# =========================
# 核心构建与依赖
# =========================
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
libs/*.jar

# =========================
# IDE 配置
# =========================
.idea/
*.iml
out/

# =========================
# 游戏运行环境
# =========================
run/

# =========================
# 缓存与临时文件
# =========================
.decomp/
.diag/
.gt/
.gtl2/
.tmp_gtl/

# 忽略根目录下所有隐藏文件夹（如图中的 .aeh, .ci, .ext 等杂项）
# 但保留 .github 和 .gitignore 本身
.*/
!.github/
!.gitignore
# 忽略临时脚本和测试截图
*.js
*.txt
_*.png